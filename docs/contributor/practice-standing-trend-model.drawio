        <mxCell id="scaleUse1" edge="1" parent="1" source="scale" style="endArrow=open;endSize=8;html=1;dashed=1;exitX=0.15;exitY=1;entryX=0.9;entryY=0;fontSize=10;fontColor=#d6b656;strokeColor=#d6b656;strokeWidth=2;" target="areaDto" value="classify()">
