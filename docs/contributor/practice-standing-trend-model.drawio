        <mxCell id="scaleUse2" edge="1" parent="1" source="scale" style="endArrow=open;endSize=8;html=1;dashed=1;exitX=0;exitY=0.6;entryX=1;entryY=0.05;fontSize=10;fontColor=#d6b656;strokeColor=#d6b656;strokeWidth=2;" target="card" value="classify()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1660" y="330" />
              <mxPoint x="1660" y="680" />
