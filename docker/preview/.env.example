# Coolify base variables for the preview-only application.
# Generate new application secrets unless a comment says a value must match staging.

POSTGRES_PASSWORD=
# Base64 of 32 random bytes: `openssl rand -base64 32`. The server refuses to start without it.
HEPHAESTUS_AUTH_STATE_COOKIE_KEY=
HEPHAESTUS_SECURITY_ENCRYPTION_KEY=
HEPHAESTUS_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
# At least 32 printable ASCII characters: `openssl rand -hex 24`. Previews receive no webhooks, but
# the server role requires the secret to be present and refuses to start without it.
WEBHOOK_SECRET=
# Required; the server aborts its boot without it. Write this regex WITHOUT backslashes: Coolify
# re-escapes them when it writes the stack .env, so an escaped dot reaches the container doubled and
# matches nothing — the proxy is then distrusted, X-Forwarded-Proto is dropped, and OAuth redirects
# are built as http://. An unescaped '.' matches any character, harmless for an IP range.
HEPHAESTUS_TRUSTED_PROXIES=172.(1[6-9]|2[0-9]|3[01]).[0-9]{1,3}.[0-9]{1,3}
# Optional. Accounts that come up as admins in the preview's empty database. Without this and the
# OAuth app below, a preview has no way in.
HEPHAESTUS_AUTH_BOOTSTRAP_ADMINS=
# Optional. The organisation setup names when it asks "Allow research use of your data?". Unset means setup
# omits the question, so a preview that is reviewing that screen has to set it.
HEPHAESTUS_RESEARCH_ORGANIZATION=

# Optional. Overrides the application server's direct-memory ceiling.
#APP_MAX_DIRECT_MEMORY=128M

# Optional approved GitHub OAuth credentials. Staging's app may be reused when its existing
# wildcard-enabled callback covers the controlled preview namespace, root domain, path and port.
# See README.md for the exact redirect contract. Do not register an app or callback per PR.
# Leave blank when GitHub sign-in is not used.
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Staging's broker, reached over its external `shared-network`. The application server consumes from
# it with a durable named per deploy, so previews never compete for one consumer. These credentials
# must match staging's broker; unlike the application secrets above, do not generate new values.
NATS_SERVER=nats://nats-server:4222
NATS_USERNAME=
NATS_PASSWORD=

# Staging's PostgreSQL, reached over `shared-network`. seed-loader takes one pg_dump from it on a
# preview's first deploy, applies the preview policy, and refuses to mark the preview seeded if that
# policy did not take — so a failure here leaves the preview un-booted rather than live on
# unsilenced data. The role is read-only and belongs to previews alone; the runbook has the grant.
PREVIEW_SEED_SOURCE_HOST=app-postgres-1
PREVIEW_SEED_SOURCE_USERNAME=preview_seed
PREVIEW_SEED_SOURCE_DATABASE=hephaestus
PREVIEW_SEED_SOURCE_PASSWORD=

# Optional, operator-owned fresh reviews for one approved PR. See README.md before enabling.
PREVIEW_FRESH_REVIEW_ENABLED=false
PREVIEW_FRESH_REVIEW_PR=
# Must match the linked GitLab identity used to create the owned test workspace.
GITLAB_DEFAULT_SERVER_URL=https://gitlab.com
# Default: two random loopback ports. Opt-in permits only the approved private worker gateway.
PREVIEW_WORKER_BIND_HOST=127.0.0.1
PREVIEW_WORKER_REGISTRATION_TOKEN=
# Exact qualified ghcr.io/hephaestus-build/agent-pi@sha256:<digest>, never a tag.
PREVIEW_AGENT_IMAGE_REFERENCE=

# Coolify supplies these values for each PR. Do not define them manually.
# SOURCE_COMMIT=
# COOLIFY_BRANCH=
# SERVICE_FQDN_WEBAPP=
