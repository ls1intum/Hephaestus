# Coolify base variables for the preview-only application.
# Generate new values for this application; do not copy them from Staging or Production.

POSTGRES_PASSWORD=
# Base64 of 32 random bytes: `openssl rand -base64 32`. The server refuses to start without it.
HEPHAESTUS_AUTH_STATE_COOKIE_KEY=
HEPHAESTUS_SECURITY_ENCRYPTION_KEY=
# At least 32 printable ASCII characters: `openssl rand -hex 24`. Previews receive no webhooks, but
# the server role requires the secret to be present and refuses to start without it.
WEBHOOK_SECRET=
# Required; the server aborts its boot without it. Write this regex WITHOUT backslashes: Coolify
# re-escapes them when it writes the stack .env, so an escaped dot reaches the container doubled and
# matches nothing — the proxy is then distrusted, X-Forwarded-Proto is dropped, and OAuth redirects
# are built as http://. An unescaped '.' matches any character, harmless for an IP range.
HEPHAESTUS_TRUSTED_PROXIES=172.(1[6-9]|2[0-9]|3[01]).[0-9]{1,3}.[0-9]{1,3}
# Optional. Accounts that come up as admins in the preview's empty database. Without this and the
# OAuth app below, a preview has no way in.
HEPHAESTUS_AUTH_BOOTSTRAP_ADMINS=

# Optional. Overrides the application server's direct-memory ceiling.
#APP_MAX_DIRECT_MEMORY=128M

# Optional preview-only GitHub OAuth app. GitHub rejects wildcard callback URLs, so one app cannot
# serve every pr<id> host at once: either re-point its callback at the preview you are signing into,
# or leave these blank and reach the preview as a bootstrap admin.
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Staging's broker, reached over its external `shared-network`. The application server consumes from
# it with a durable named per deploy, so previews never compete for one consumer.
NATS_SERVER=nats://nats-server:4222

# The running staging PostgreSQL container. seed-loader takes one pg_dump from it on a preview's
# first deploy, applies the preview policy, and refuses to mark the preview seeded if that policy
# did not take — so a failure here leaves the preview un-booted rather than live on unsilenced data.
PREVIEW_SEED_SOURCE_CONTAINER=app-postgres-1
PREVIEW_SEED_SOURCE_USERNAME=root
PREVIEW_SEED_SOURCE_DATABASE=hephaestus

# Coolify supplies these values for each PR. Do not define them manually.
# SOURCE_COMMIT=
# COOLIFY_BRANCH=
# SERVICE_FQDN_WEBAPP=
# SERVICE_FQDN_APPSERVER=
