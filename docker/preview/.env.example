# =============================================================================
# PREVIEW DEPLOYMENT ENVIRONMENT VARIABLES (Coolify)
# =============================================================================
#
# Configure these in Coolify's Environment Variables section.
# Coolify Auto-Generated Variables (don't set these):
#   - SERVICE_FQDN_WEBAPP: Domain assigned to webapp service
#   - SERVICE_FQDN_APPSERVER: Domain assigned to the API service
#   - SERVICE_NAME_POSTGRES: Preview-specific PostgreSQL service/network alias
#   - COOLIFY_BRANCH: Git branch name
#   - COOLIFY_CONTAINER_NAME: Container name with UUID
#
# =============================================================================

# -----------------------------------------------------------------------------
# SHARED STAGING INFRASTRUCTURE
# -----------------------------------------------------------------------------

# Preview app servers join staging's external `shared-network` and consume from its NATS with a
# unique durable consumer.
NATS_SERVER=nats://nats-server:4222
HEPHAESTUS_SYNC_NATS_SERVER=nats://nats-server:4222
NATS_ENABLED=true

# Running staging PostgreSQL source. seed-loader takes one fail-closed pg_dump on first deploy only.
PREVIEW_SEED_SOURCE_CONTAINER=app-postgres-1
PREVIEW_SEED_SOURCE_USERNAME=root
PREVIEW_SEED_SOURCE_DATABASE=hephaestus

# Staging owns inbound webhooks. Previews consume the resulting events from NATS instead of
# registering preview-specific webhook receivers.
PREVIEW_DOMAIN=hephaestus.felixdietrich.com
WEBHOOK_EXTERNAL_URL=https://staging.hephaestus.aet.cit.tum.de

# Optional operator override. Leave this blank for previews: Coolify injects SOURCE_COMMIT and the
# application server pulls that immutable CI image. PostgreSQL continues to use `latest`.
IMAGE_TAG=

# Webhook secret for GitHub and GitLab webhooks (prefer SHA-256; e.g., `openssl rand -hex 32`)
WEBHOOK_SECRET=

# Auth (Hephaestus-native — no Keycloak; ADR 0017)
# Base64 32-byte AES key for OAuth state cookies. Generate: openssl rand -base64 32
HEPHAESTUS_AUTH_STATE_COOKIE_KEY=
# Exactly 32 chars — AES key for credential encryption (used by every pod, incl. the webhook receiver).
HEPHAESTUS_SECURITY_ENCRYPTION_KEY=
# GitHub OAuth App. Named GH_OAUTH_* (not GITHUB_OAUTH_*) to match compose.app.yaml, which maps
# these onto the GITHUB_OAUTH_* the server reads — GitHub Actions reserves the GITHUB_ prefix.
# The API is served at the root of its own host in previews (no /api base path), so the callback is
# https://<appserver-fqdn>/login/oauth2/code/github.
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=
# GitLab OAuth app (optional; gitlab.com or self-hosted); callback .../login/oauth2/code/gitlab
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_BASE_URL=https://gitlab.com
GITLAB_OAUTH_DISPLAY_NAME=GitLab

# Outline documentation integration. The flag gates the preview's admin surface, sync, and agent
# context. Staging's webhook receiver must enable the same integration independently. Outline's
# webhook secret is per-subscription and stored encrypted on the connection row, so there is no
# signing-secret environment variable.
HEPHAESTUS_INTEGRATION_OUTLINE_ENABLED=false
HEPHAESTUS_INTEGRATION_OUTLINE_ALLOWED_ORIGINS=
# Link-only login provider (never a sign-in button). BASE_URL is REQUIRED whenever CLIENT_ID is set —
# Outline is self-hosted, so there is no default origin, and a blank/invalid value makes the seed skip
# with an ERROR. Callback: https://<appserver-fqdn>/login/oauth2/code/outline, scope `read`.
OUTLINE_OAUTH_BASE_URL=
OUTLINE_OAUTH_DISPLAY_NAME=Outline
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# APPLICATION STACK (compose.app.yaml)
# -----------------------------------------------------------------------------

# PostgreSQL password for per-PR database
POSTGRES_PASSWORD=hephaestus-preview

# GitHub App credentials
GH_APP_ID=
GH_APP_PRIVATE_KEY=
GH_AUTH_TOKEN=
# Install URL shown in the workspace creation wizard
GH_APP_INSTALLATION_URL=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Agent/review execution is available but every cloned workspace begins paused in the database.
AGENT_ENABLED=true
GIT_CHECKOUT_ENABLED=true
SANDBOX_MAX_CONCURRENT=1
SANDBOX_MEMORY_BYTES=2147483648
SANDBOX_CPUS=1.0

# Monitoring (relaxed defaults for previews)
MONITORING_TIMEFRAME=14
MONITORING_RUN_ON_STARTUP=false
MONITORING_SYNC_CRON=0 0 2 * * *

# Observability
SENTRY_DSN=

# UI debugging
TANSTACK_DEVTOOLS_ENABLED=true

# Preview integrations remain opt-in, but sandbox execution, git checkout, and practice-review
# rollout testing are supported. Enable one workspace's review model binding and trigger in the UI.

# HEPHAESTUS_AGENT_IMAGE_REFERENCE=ghcr.io/ls1intum/hephaestus/agent-pi@sha256:<digest>  # preview override only

# Supplementary group the application server and worker join so they can reach the Docker socket
# the agent sandbox runs containers through. The image runs unprivileged and the socket is
# root:docker 0660, so without this every sandbox start fails with "permission denied" and no
# practice review can run. There is no portable default — read the host's group id with
# `getent group docker | cut -d: -f3`.
# DOCKER_GROUP_ID=999
