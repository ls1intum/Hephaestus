// Optional example: ships the Hephaestus service logs from the host journal to a Loki that the
// operator runs. Nothing in this repository starts Alloy, and nothing is sent until LOKI_PUSH_URL names
// a destination. docs/admin/observability.mdx explains each choice below.
//
// Alloy reads the journal as a member of the systemd-journal group. That group can read the whole host
// journal, including sshd and sudo entries; `matches` below limits what Alloy ships, not what it can read.
// It needs no Docker socket, which would give it control of every container on the host.

loki.source.journal "hephaestus" {
  // Only the three Java runtime roles that compose.journald.yaml tagged. The webapp, sandbox containers,
  // PostgreSQL and host units carry no such tag, and neither does any entry written before the overlay.
  matches       = "CONTAINER_TAG=hephaestus-runtime"
  // On a first start or after a long outage, older entries stay in the journal and are not sent.
  max_age       = "12h"
  relabel_rules = loki.relabel.hephaestus.rules
  forward_to    = [loki.process.hephaestus.receiver]
  // An empty label value would drop the label; an unset name stays visible as "unset".
  labels        = {
    deployment_environment = coalesce(sys.env("DEPLOYMENT_ENVIRONMENT"), "unset"),
  }
}

loki.relabel "hephaestus" {
  forward_to = []

  // The service is the only per-entry index label. Compose names a container
  // <project>-<service>-<n>, and the three services are a fixed set.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = ".*?(application-server|application-worker|webhook-server)(?:[-_][0-9]+)?"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["service_name"]
    regex         = ""
    action        = "drop"
  }
}

loki.process "hephaestus" {
  forward_to = [loki.write.operator.receiver]

  // The trace id answers "which request was this" without becoming an index label. Workspace and job
  // identifiers stay in the line, readable with `| json` and never indexed.
  stage.json {
    expressions = {
      trace_id = "context.traceId",
    }
  }

  stage.structured_metadata {
    values = {
      trace_id = "",
    }
  }
}

loki.write "operator" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")

    // After these retries a batch is dropped; the journal still holds the lines for its own retention.
    max_backoff_period  = "5m"
    max_backoff_retries = 10
  }
}
