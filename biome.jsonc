{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	// Root of the Biome monorepo graph. `webapp/biome.jsonc` is the one nested config; it declares
	// `"root": false` and keeps its own formatter settings.
	// This file formats the TypeScript and JavaScript outside the webapp and the docs site:
	//   - the Bun agent runtime          server/application/src/main/resources/agent/**
	//   - its runner specs               server/application/src/test/resources/agent/**
	//   - the shipped precompute scripts server/application/src/main/resources/practices/precompute/**
	//   - the precompute harness         docker/agents/precompute/**
	//   - the repo tooling scripts       scripts/**
	// `tsconfig.agents.json` and `scripts/tsconfig.json` type-check that set; `docs/` is a third
	// workspace package with its own tooling. oxlint lints all three — see `.oxlintrc.json`.
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		// .gitignore already prunes node_modules/ and target/, so no negations are needed here.
		"ignoreUnknown": true,
		"includes": [
			"server/application/src/main/resources/agent/**/*.ts",
			"server/application/src/test/resources/agent/**/*.ts",
			"server/application/src/main/resources/practices/precompute/**/*.ts",
			"docker/agents/precompute/**/*.ts",
			"scripts/**/*.ts"
		]
	},
	// Byte-identical to webapp/biome.jsonc's formatter so a contributor moving between the SPA and
	// the agent runtime never re-learns the house style.
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	// oxlint lints every tree in this repo (`.oxlintrc.json`, and the nested configs under
	// `webapp/` and `docs/`). Biome formats and sorts imports.
	"linter": { "enabled": false },
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	}
}
