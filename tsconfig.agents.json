{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2024", "DOM", "DOM.AsyncIterable"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"strict": true,
		// Regex captures and split() results are the dominant shape here; without this they read as
		// always-present and an unmatched group becomes a runtime undefined instead of a build error.
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noEmit": true,
		// Relative imports resolve beside each staged script, across lib/core and domain kits.
		// through the link the runtime creates to the toolkit (`PracticeRunnerProfile.setupCommands`).
		"rootDirs": [
			"server/application/src/main/resources/practices",
			"server/application/src/main/resources/agent/work/practice-scripts",
			"docker/agents/practice-scripts"
		]
	},
	// The link checked in for tests and editors points at the toolkit, which is type-checked once, at home.
	"exclude": ["server/application/src/main/resources/agent/work/**"],
	"include": [
		"server/application/src/main/resources/agent/**/*.ts",
		"server/application/src/test/resources/agent/**/*.ts",
		"server/application/src/test/resources/integration/scm/sarif/**/*.ts",
		"server/application/src/main/resources/practices/scripts/**/*.ts",
		"docker/agents/practice-scripts/**/*.ts",
		"docker/agents/pi/**/*.ts"
	]
}
