{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		// ESNext, not ES2023: Array.fromAsync ships in Node 24 but only lib.esnext types it.
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		// The workflows import preview-controller.ts through actions/github-script, which runs on
		// Node type stripping rather than Bun; syntax that needs a transform would fail there at
		// runtime with no local signal.
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["./**/*.ts"]
}
