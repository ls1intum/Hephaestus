<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.tum.cit.aet</groupId>
        <artifactId>hephaestus-server-parent</artifactId>
        <version>0.0.0-development</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>hephaestus-generated-clients</artifactId>
    <name>Hephaestus generated clients</name>
    <dependencies>
        <dependency>
            <groupId>io.github.kobylynskyi</groupId>
            <artifactId>graphql-java-codegen</artifactId>
            <version>${graphql-codegen.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-graphql-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/graphql-github</source>
                                <source>${project.build.directory}/generated-sources/graphql-gitlab</source>
                                <source>${project.build.directory}/generated-sources/openapi-outline</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.kobylynskyi</groupId>
                <artifactId>graphql-codegen-maven-plugin</artifactId>
                <version>${graphql-codegen.version}</version>
                <executions>
                    <execution>
                        <id>generate-github-graphql-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <skipSchemaSizeLimit>true</skipSchemaSizeLimit>
                            <graphqlSchemas>
                                <rootDir>${project.basedir}/src/main/resources/graphql/github</rootDir>
                            </graphqlSchemas>
                            <outputDir>${project.build.directory}/generated-sources/graphql-github</outputDir>
                            <packageName>de.tum.cit.aet.hephaestus.integration.scm.github.graphql</packageName>
                            <apiPackageName>de.tum.cit.aet.hephaestus.integration.scm.github.graphql.api</apiPackageName>
                            <modelPackageName>de.tum.cit.aet.hephaestus.integration.scm.github.graphql.model
                            </modelPackageName>
                            <modelNamePrefix>GH</modelNamePrefix>
                            <generateClient>true</generateClient>
                            <generateApis>false</generateApis>
                            <generateDataFetchingEnvironmentArgumentInApis>false
                            </generateDataFetchingEnvironmentArgumentInApis>
                            <generateBuilder>true</generateBuilder>
                            <generateEqualsAndHashCode>true</generateEqualsAndHashCode>
                            <generateToString>true</generateToString>
                            <generateParameterizedFieldsResolvers>false</generateParameterizedFieldsResolvers>
                            <generateModelsForRootTypes>false</generateModelsForRootTypes>
                            <generateAllMethodInProjection>true</generateAllMethodInProjection>
                            <fieldsWithoutResolvers>
                                <fieldWithoutResolver>node</fieldWithoutResolver>
                                <fieldWithoutResolver>nodes</fieldWithoutResolver>
                                <fieldWithoutResolver>relay</fieldWithoutResolver>
                            </fieldsWithoutResolvers>
                            <generatedLanguage>JAVA</generatedLanguage>
                            <addGeneratedAnnotation>true</addGeneratedAnnotation>
                            <generatedAnnotation>jakarta.annotation.Generated</generatedAnnotation>
                            <modelValidationAnnotation>@jakarta.annotation.Generated("graphql-codegen")
                            </modelValidationAnnotation>
                            <customTypesMapping>
                                <DateTime>java.time.OffsetDateTime</DateTime>
                                <Date>java.time.LocalDate</Date>
                                <URI>java.net.URI</URI>
                                <HTML>java.lang.String</HTML>
                                <GitObjectID>java.lang.String</GitObjectID>
                                <GitSSHRemote>java.lang.String</GitSSHRemote>
                                <GitTimestamp>java.time.OffsetDateTime</GitTimestamp>
                                <PreciseDateTime>java.time.OffsetDateTime</PreciseDateTime>
                                <X509Certificate>java.lang.String</X509Certificate>
                                <Base64String>java.lang.String</Base64String>
                                <BigInt>java.math.BigInteger</BigInt>
                            </customTypesMapping>
                            <modelNameSuffix />
                            <requestSuffix>Request</requestSuffix>
                            <responseSuffix>Response</responseSuffix>
                            <responseProjectionSuffix>ResponseProjection</responseProjectionSuffix>
                            <!-- The custom projection template omits generator-internal state. -->
                            <customTemplatesRoot>${project.basedir}/src/main/resources/graphql/templates
                            </customTemplatesRoot>
                            <customTemplates>
                                <RESPONSE_PROJECTION>response_projection.ftl</RESPONSE_PROJECTION>
                            </customTemplates>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-gitlab-graphql-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <skipSchemaSizeLimit>true</skipSchemaSizeLimit>
                            <graphqlSchemas>
                                <rootDir>${project.basedir}/src/main/resources/graphql/gitlab</rootDir>
                            </graphqlSchemas>
                            <outputDir>${project.build.directory}/generated-sources/graphql-gitlab</outputDir>
                            <packageName>de.tum.cit.aet.hephaestus.integration.scm.gitlab.graphql</packageName>
                            <apiPackageName>de.tum.cit.aet.hephaestus.integration.scm.gitlab.graphql.api</apiPackageName>
                            <modelPackageName>de.tum.cit.aet.hephaestus.integration.scm.gitlab.graphql.model
                            </modelPackageName>
                            <modelNamePrefix>GL</modelNamePrefix>
                            <generateClient>true</generateClient>
                            <generateApis>false</generateApis>
                            <generateDataFetchingEnvironmentArgumentInApis>false
                            </generateDataFetchingEnvironmentArgumentInApis>
                            <generateBuilder>true</generateBuilder>
                            <generateEqualsAndHashCode>true</generateEqualsAndHashCode>
                            <generateToString>true</generateToString>
                            <generateParameterizedFieldsResolvers>false</generateParameterizedFieldsResolvers>
                            <generateModelsForRootTypes>false</generateModelsForRootTypes>
                            <generateAllMethodInProjection>true</generateAllMethodInProjection>
                            <!-- Avoid the JVM's 255-parameter limit for large schema types. -->
                            <generateNoArgsConstructorOnly>true</generateNoArgsConstructorOnly>
                            <generatedLanguage>JAVA</generatedLanguage>
                            <addGeneratedAnnotation>true</addGeneratedAnnotation>
                            <generatedAnnotation>jakarta.annotation.Generated</generatedAnnotation>
                            <modelValidationAnnotation>@jakarta.annotation.Generated("graphql-codegen")
                            </modelValidationAnnotation>
                            <customTypesMapping>
                                <Time>java.time.OffsetDateTime</Time>
                                <ISO8601DateTime>java.time.OffsetDateTime</ISO8601DateTime>
                                <ISO8601Date>java.time.LocalDate</ISO8601Date>
                                <GlobalID>java.lang.String</GlobalID>
                                <JSON>java.lang.Object</JSON>
                                <UntrustedRegexp>java.lang.String</UntrustedRegexp>
                                <Duration>java.lang.String</Duration>
                                <BigInt>java.math.BigInteger</BigInt>
                                <TodoableID>java.lang.String</TodoableID>
                                <UserID>java.lang.String</UserID>
                                <IterationID>java.lang.String</IterationID>
                                <MilestoneID>java.lang.String</MilestoneID>
                                <WorkItemID>java.lang.String</WorkItemID>
                                <IssueID>java.lang.String</IssueID>
                                <ProjectID>java.lang.String</ProjectID>
                                <GroupID>java.lang.String</GroupID>
                                <LabelsFilterType>java.lang.String</LabelsFilterType>
                                <NegatedIterationWildcardId>java.lang.String</NegatedIterationWildcardId>
                                <Upload>java.lang.String</Upload>
                                <Color>java.lang.String</Color>
                                <PaymentMethodID>java.lang.String</PaymentMethodID>
                                <NamespaceID>java.lang.String</NamespaceID>
                                <AuditEventsStreamingHeadersID>java.lang.String</AuditEventsStreamingHeadersID>
                                <AuditEventsExternalAuditEventDestinationID>java.lang.String</AuditEventsExternalAuditEventDestinationID>
                                <GoogleCloudLoggingConfigurationID>java.lang.String</GoogleCloudLoggingConfigurationID>
                                <AmazonS3ConfigurationID>java.lang.String</AmazonS3ConfigurationID>
                                <InstanceAuditEventsStreamingHeadersID>java.lang.String</InstanceAuditEventsStreamingHeadersID>
                                <InstanceExternalAuditEventDestinationID>java.lang.String</InstanceExternalAuditEventDestinationID>
                                <InstanceGoogleCloudLoggingConfigurationID>java.lang.String</InstanceGoogleCloudLoggingConfigurationID>
                                <InstanceAmazonS3ConfigurationID>java.lang.String</InstanceAmazonS3ConfigurationID>
                                <JsonString>java.lang.String</JsonString>
                            </customTypesMapping>
                            <modelNameSuffix />
                            <requestSuffix>Request</requestSuffix>
                            <responseSuffix>Response</responseSuffix>
                            <responseProjectionSuffix>ResponseProjection</responseProjectionSuffix>
                            <customTemplatesRoot>${project.basedir}/src/main/resources/graphql/templates
                            </customTemplatesRoot>
                            <customTemplates>
                                <RESPONSE_PROJECTION>response_projection.ftl</RESPONSE_PROJECTION>
                            </customTemplates>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>remove-invalid-relay-models</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- GraphQL Java Codegen emits these wrappers without their required Query root model. -->
                                <delete>
                                    <fileset dir="${project.build.directory}/generated-sources/graphql-github/de/tum/cit/aet/hephaestus/integration/scm/github/graphql/model">
                                        <include name="RelayQueryRequest.java" />
                                        <include name="RelayQueryResponse.java" />
                                    </fileset>
                                </delete>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>outline-spec3</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/outline/spec3.yml</inputSpec>
                            <generatorName>java</generatorName>
                            <library>webclient</library>
                            <output>${project.build.directory}/generated-sources/openapi-outline</output>
                            <modelPackage>de.tum.cit.aet.hephaestus.integration.outline.client.model</modelPackage>
                            <modelNamePrefix>Outline</modelNamePrefix>
                            <!-- Avoid simple-name collisions with JPA entities. -->
                            <modelNameMappings>
                                <modelNameMapping>Collection=OutlineCollectionModel</modelNameMapping>
                                <modelNameMapping>Document=OutlineDocumentModel</modelNameMapping>
                            </modelNameMappings>
                            <generateApis>false</generateApis>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelTests>false</generateModelTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <typeMappings>
                                <typeMapping>OffsetDateTime=Instant</typeMapping>
                                <!-- Outline IDs remain strings to match persisted domain IDs. -->
                                <typeMapping>UUID=String</typeMapping>
                            </typeMappings>
                            <importMappings>
                                <importMapping>OffsetDateTime=java.time.Instant</importMapping>
                            </importMappings>
                            <configOptions>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <sourceFolder>.</sourceFolder>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <!-- Accept enum values added by newer Outline servers. -->
                                <enumUnknownDefaultCase>true</enumUnknownDefaultCase>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>outline-supplement</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/outline/outline-supplement.yaml</inputSpec>
                            <generatorName>java</generatorName>
                            <library>webclient</library>
                            <output>${project.build.directory}/generated-sources/openapi-outline</output>
                            <modelPackage>de.tum.cit.aet.hephaestus.integration.outline.client.model</modelPackage>
                            <modelNamePrefix>Outline</modelNamePrefix>
                            <modelNameMappings>
                                <modelNameMapping>Collection=OutlineCollectionModel</modelNameMapping>
                                <modelNameMapping>Document=OutlineDocumentModel</modelNameMapping>
                            </modelNameMappings>
                            <generateApis>false</generateApis>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelTests>false</generateModelTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <typeMappings>
                                <typeMapping>OffsetDateTime=Instant</typeMapping>
                                <typeMapping>UUID=String</typeMapping>
                            </typeMappings>
                            <importMappings>
                                <importMapping>OffsetDateTime=java.time.Instant</importMapping>
                            </importMappings>
                            <configOptions>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <sourceFolder>.</sourceFolder>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <enumUnknownDefaultCase>true</enumUnknownDefaultCase>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <proc>none</proc>
                    <showWarnings>false</showWarnings>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
