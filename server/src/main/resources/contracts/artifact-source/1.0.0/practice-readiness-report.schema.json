{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaestus.aet.cit.tum.de/contracts/artifact-source/1.0.0/practice-readiness-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "catalogDigest",
    "profileId",
    "manifestCapturedAt",
    "decidedAt",
    "decisions"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "catalogDigest": {
      "const": "3ee0ecd611114c0543208598fe20af834c32f2f08827eed5afcafff323e09600"
    },
    "profileId": {
      "enum": [
        "pull-request-review",
        "issue-review",
        "conversation-review"
      ]
    },
    "manifestCapturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decision"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "practiceSlug",
        "decidedAt",
        "ready",
        "assessments"
      ],
      "properties": {
        "practiceSlug": {
          "type": "string",
          "minLength": 1
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ready": {
          "type": "boolean"
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessment"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.pull-request.core",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.pull-request.diff",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.pull-request.comments",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.repository.tree",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.issue.core",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.issue.comments",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "slack.conversation.thread",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.linked-work-items",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.review-threads",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "scm.general-review-comments",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "workspace.project-inventory",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "outline.documents",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "ready": {
                "const": true
              }
            },
            "required": [
              "ready"
            ]
          },
          "then": {
            "properties": {
              "assessments": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/assessment"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "acceptable": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "assessments": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "acceptable": {
                      "const": false
                    }
                  },
                  "required": [
                    "acceptable"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "policyVersion",
        "assessedAt",
        "temporalAnchor",
        "freshness",
        "acceptable",
        "reasonCodes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "scm.pull-request.core",
            "scm.pull-request.diff",
            "scm.pull-request.comments",
            "scm.repository.tree",
            "scm.issue.core",
            "scm.issue.comments",
            "slack.conversation.thread",
            "scm.linked-work-items",
            "scm.review-threads",
            "scm.general-review-comments",
            "workspace.project-inventory",
            "outline.documents"
          ]
        },
        "policyVersion": {
          "const": "1.0.0"
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        },
        "temporalAnchor": {
          "type": "string",
          "format": "date-time"
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        },
        "acceptable": {
          "type": "boolean"
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "acceptable": {
                "const": true
              }
            },
            "required": [
              "acceptable"
            ]
          },
          "then": {
            "properties": {
              "reasonCodes": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reasonCodes": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "profileId": {
            "const": "pull-request-review"
          }
        },
        "required": [
          "profileId"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "decisions": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/decision"
                },
                {
                  "type": "object",
                  "properties": {
                    "assessments": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/assessment"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "enum": [
                                  "scm.pull-request.core",
                                  "scm.pull-request.diff",
                                  "scm.pull-request.comments",
                                  "scm.repository.tree",
                                  "scm.linked-work-items",
                                  "scm.review-threads",
                                  "scm.general-review-comments",
                                  "workspace.project-inventory",
                                  "outline.documents"
                                ]
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "profileId": {
            "const": "issue-review"
          }
        },
        "required": [
          "profileId"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "decisions": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/decision"
                },
                {
                  "type": "object",
                  "properties": {
                    "assessments": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/assessment"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "enum": [
                                  "scm.issue.core",
                                  "scm.issue.comments",
                                  "workspace.project-inventory",
                                  "outline.documents"
                                ]
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "profileId": {
            "const": "conversation-review"
          }
        },
        "required": [
          "profileId"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "decisions": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/decision"
                },
                {
                  "type": "object",
                  "properties": {
                    "assessments": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/assessment"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "enum": [
                                  "slack.conversation.thread",
                                  "workspace.project-inventory"
                                ]
                              }
                            },
                            "required": [
                              "kind"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
