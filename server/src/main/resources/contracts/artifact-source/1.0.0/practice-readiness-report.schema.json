{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaestus.aet.cit.tum.de/contracts/artifact-source/1.0.0/practice-readiness-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "catalogDigest",
    "profileId",
    "manifestCapturedAt",
    "decidedAt",
    "decisions"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "catalogDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "manifestCapturedAt": { "type": "string", "format": "date-time" },
    "decidedAt": { "type": "string", "format": "date-time" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practiceSlug", "decidedAt", "ready", "assessments"],
      "properties": {
        "practiceSlug": { "type": "string", "minLength": 1 },
        "decidedAt": { "type": "string", "format": "date-time" },
        "ready": { "type": "boolean" },
        "assessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assessment" }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "policyVersion",
        "assessedAt",
        "temporalAnchor",
        "freshness",
        "acceptable",
        "reasonCodes"
      ],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
        "policyVersion": { "const": "1.0.0" },
        "assessedAt": { "type": "string", "format": "date-time" },
        "temporalAnchor": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
        "acceptable": { "type": "boolean" },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    }
  }
}
