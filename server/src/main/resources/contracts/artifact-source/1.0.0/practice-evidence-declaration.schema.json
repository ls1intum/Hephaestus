{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaestus.aet.cit.tum.de/contracts/artifact-source/1.0.0/practice-evidence-declaration.schema.json",
  "title": "Practice evidence declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceContractVersion",
    "profile",
    "detectorCapability",
    "required",
    "optional",
    "onUnsatisfied",
    "blindSpots"
  ],
  "properties": {
    "sourceContractVersion": {
      "const": "1.0.0"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "detectorCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentMethod", "evidenceCoverage"],
      "properties": {
        "assessmentMethod": {
          "enum": ["MECHANICAL", "SEMANTIC", "NONE"]
        },
        "evidenceCoverage": {
          "enum": ["DECLARED_REQUIREMENTS_SUFFICIENT", "CONDITIONAL", "NONE"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assessmentMethod": {
                "const": "NONE"
              }
            },
            "required": ["assessmentMethod"]
          },
          "then": {
            "properties": {
              "evidenceCoverage": {
                "const": "NONE"
              }
            }
          },
          "else": {
            "properties": {
              "evidenceCoverage": {
                "enum": ["DECLARED_REQUIREMENTS_SUFFICIENT", "CONDITIONAL"]
              }
            }
          }
        }
      ],
      "description": "How Hephaestus evaluates the practice and whether the declared integration evidence covers every case; this does not classify human observation."
    },
    "required": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "optional": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/optionalRequirement"
      }
    },
    "onUnsatisfied": {
      "const": "DECLINE_SEMANTIC_JUDGMENT"
    },
    "blindSpots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blindSpot"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detectorCapability": {
            "type": "object",
            "properties": {
              "assessmentMethod": {
                "const": "NONE"
              }
            },
            "required": ["assessmentMethod"]
          }
        },
        "required": ["detectorCapability"]
      },
      "then": {
        "properties": {
          "required": {
            "type": "array",
            "maxItems": 0
          },
          "optional": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "required": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "completeness", "freshness"],
      "properties": {
        "sourceKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "completeness": {
          "enum": ["COMPLETE", "ANY"]
        },
        "freshness": {
          "enum": ["CURRENT", "ANY"]
        }
      }
    },
    "optionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "completeness",
        "freshness"
      ],
      "properties": {
        "sourceKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "completeness": {
          "const": "ANY"
        },
        "freshness": {
          "const": "ANY"
        }
      }
    },
    "blindSpot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
