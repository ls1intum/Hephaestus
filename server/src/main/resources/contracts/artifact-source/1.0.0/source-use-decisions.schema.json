{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaestus.aet.cit.tum.de/contracts/artifact-source/1.0.0/source-use-decisions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "decisions"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "purpose",
          "mode",
          "basis",
          "outcome",
          "audience",
          "retentionPolicy",
          "erasurePolicy",
          "recordedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "PRODUCT",
              "EVALUATION"
            ]
          },
          "basis": {
            "enum": [
              "ENGINEERING_BASELINE",
              "CONTROLLER_DECISION"
            ]
          },
          "outcome": {
            "enum": [
              "ENGINEERING_APPROVED",
              "APPROVED",
              "DENIED"
            ]
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "modelProcessor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "retentionPolicy": {
            "const": "AGENT_EVIDENCE_RETENTION"
          },
          "erasurePolicy": {
            "const": "WORKSPACE_AND_PERSON_ERASURE"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "ENGINEERING_BASELINE"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "reviewer",
                "decidedAt",
                "expiresAt"
              ],
              "properties": {
                "outcome": {
                  "const": "ENGINEERING_APPROVED"
                },
                "reviewer": true,
                "decidedAt": true,
                "expiresAt": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "CONTROLLER_DECISION"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "reviewer",
                "decidedAt",
                "expiresAt"
              ],
              "properties": {
                "outcome": {
                  "enum": [
                    "APPROVED",
                    "DENIED"
                  ]
                },
                "reviewer": true,
                "decidedAt": true,
                "expiresAt": true
              }
            }
          }
        ]
      }
    }
  }
}
