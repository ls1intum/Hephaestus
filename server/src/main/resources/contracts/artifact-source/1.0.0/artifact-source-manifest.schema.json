{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaestus.aet.cit.tum.de/contracts/artifact-source/1.0.0/artifact-source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "catalogDigest",
    "profileId",
    "capturedAt",
    "sources",
    "viewTransformations"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "catalogDigest": {
      "const": "3ee0ecd611114c0543208598fe20af834c32f2f08827eed5afcafff323e09600"
    },
    "profileId": {
      "enum": [
        "pull-request-review",
        "issue-review",
        "conversation-review"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capture"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.pull-request.core",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.pull-request.diff",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.pull-request.comments",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.repository.tree",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.issue.core",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.issue.comments",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "slack.conversation.thread",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.linked-work-items",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.review-threads",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "scm.general-review-comments",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "workspace.project-inventory",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "outline.documents",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "viewTransformations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transformation"
      }
    }
  },
  "$defs": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "state",
        "artifacts"
      ],
      "properties": {
        "kind": {
          "enum": [
            "scm.pull-request.core",
            "scm.pull-request.diff",
            "scm.pull-request.comments",
            "scm.repository.tree",
            "scm.issue.core",
            "scm.issue.comments",
            "slack.conversation.thread",
            "scm.linked-work-items",
            "scm.review-threads",
            "scm.general-review-comments",
            "workspace.project-inventory",
            "outline.documents"
          ]
        },
        "state": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "availability",
                "content",
                "completeness",
                "facts"
              ],
              "properties": {
                "availability": {
                  "const": "AVAILABLE"
                },
                "content": {
                  "enum": [
                    "EMPTY",
                    "NON_EMPTY"
                  ]
                },
                "completeness": {
                  "enum": [
                    "COMPLETE",
                    "PARTIAL",
                    "UNKNOWN"
                  ]
                },
                "facts": {
                  "$ref": "#/$defs/facts"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "availability",
                "reasonCode"
              ],
              "properties": {
                "availability": {
                  "enum": [
                    "NOT_COLLECTED",
                    "UNAVAILABLE",
                    "REDACTED"
                  ]
                },
                "reasonCode": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "availability",
                "errorCode"
              ],
              "properties": {
                "availability": {
                  "const": "COLLECTION_ERROR"
                },
                "errorCode": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              }
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "type": "object",
                "properties": {
                  "availability": {
                    "not": {
                      "const": "AVAILABLE"
                    }
                  }
                },
                "required": [
                  "availability"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "type": "object",
                "properties": {
                  "availability": {
                    "const": "AVAILABLE"
                  },
                  "content": {
                    "const": "NON_EMPTY"
                  }
                },
                "required": [
                  "availability",
                  "content"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "queryScope",
        "completenessBasis",
        "representationFidelity"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceEffectiveAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "immutableIdentity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "queryScope": {
          "type": "string",
          "minLength": 1
        },
        "completenessBasis": {
          "enum": [
            "CURSOR_EXHAUSTED",
            "KNOWN_TOTAL",
            "LIMIT_EXCEEDED",
            "BOUNDED_SCOPE",
            "IMMUTABLE_OBJECT",
            "UNKNOWN"
          ]
        },
        "representationFidelity": {
          "enum": [
            "EXACT",
            "LOSSLESS_DERIVATION",
            "LOSSY_DERIVATION"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\u0000]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "planId",
        "removedSources"
      ],
      "properties": {
        "kind": {
          "const": "ABLATION"
        },
        "planId": {
          "type": "string",
          "minLength": 1
        },
        "removedSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profileId": {
            "const": "pull-request-review"
          }
        },
        "required": [
          "profileId"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 9,
            "maxItems": 9,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.pull-request.core"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.pull-request.diff"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.pull-request.comments"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.repository.tree"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.linked-work-items"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.review-threads"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.general-review-comments"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "workspace.project-inventory"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "outline.documents"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            ],
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "profileId": {
            "const": "issue-review"
          }
        },
        "required": [
          "profileId"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 4,
            "maxItems": 4,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.issue.core"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "scm.issue.comments"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "workspace.project-inventory"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "outline.documents"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            ],
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "profileId": {
            "const": "conversation-review"
          }
        },
        "required": [
          "profileId"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "slack.conversation.thread"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "workspace.project-inventory"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            ],
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
