      "erasurePolicy": "WORKSPACE_AND_PERSON_ERASURE",
      "useDecisionId": "use-scm-pull-request-comments"
    },
    {
      "kind": "scm.repository.tree",
      "description": "Pinned repository files used only as surrounding code context.",
      "selectionScope": "Up to 20,000 regular files and 50 MiB at the pinned commit; files over 10 MiB, symlinks, submodules, unsafe paths, and unsupported Git modes are excluded and make the source PARTIAL.",
      "artifactTypes": [
        "PULL_REQUEST"
      ],
      "authority": "UPSTREAM_SNAPSHOT",
      "captureTime": "PINNED_IMMUTABLE_IDENTITY",
