      "displayName": "Pull request details",
      "description": "Pull request metadata and commit subjects for the reviewed pull request.",
      "selectionScope": "One pull request pinned by job metadata; core fields plus the available commit-subject list.",
      "artifactTypes": [
        "PULL_REQUEST"
      ],
      "authority": "SYNCHRONIZED_MIRROR",
      "captureTimeBasis": "COLLECTION_TIME_SNAPSHOT",
      "freshness": {
        "mode": "MAX_AGE",
        "maxAgeSeconds": 300
