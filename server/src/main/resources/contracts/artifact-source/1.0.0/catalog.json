{
  "version": "1.0.0",
  "sources": [
    {
      "kind": "scm.pull-request.core",
      "description": "Pull request metadata and commit subjects for the reviewed artifact.",
      "selectionScope": "One pull request pinned by job metadata; core fields plus the available commit-subject list.",
      "artifactTypes": [
        "PULL_REQUEST"
      ],
      "authority": "SYNCHRONIZED_MIRROR",
      "captureTime": "COLLECTION_TIME_SNAPSHOT",
      "freshness": {
        "mode": "MAX_AGE",
        "maxAgeSeconds": 300
      },
      "completeness": {
        "supportsComplete": true,
        "supportsPartial": true,
        "supportsEmpty": false
      },
      "privacyClass": "PERSONAL",
      "supportedMissingness": [
        "NOT_COLLECTED",
        "UNAVAILABLE",
        "REDACTED",
        "COLLECTION_ERROR"
      ],
      "purpose": "practice-detection",
      "retentionPolicy": "AGENT_EVIDENCE_RETENTION",
      "erasurePolicy": "WORKSPACE_AND_PERSON_ERASURE",
      "useDecisionId": "use-scm-pull-request-core"
    },
    {
      "kind": "scm.pull-request.diff",
      "description": "Annotated unified diff and deterministic summaries for the reviewed pull request.",
      "selectionScope": "The merge-base-to-pinned-head diff for one pull request, capped at 20 MiB; collection fails closed if the range cannot be resolved or exceeds the cap.",
      "artifactTypes": [
        "PULL_REQUEST"
      ],
      "authority": "DETERMINISTIC_DERIVATION",
      "captureTime": "PINNED_IMMUTABLE_IDENTITY",
      "freshness": {
        "mode": "PINNED_IDENTITY"
      },
      "completeness": {
        "supportsComplete": true,
        "supportsPartial": false,
        "supportsEmpty": true
      },
      "privacyClass": "INTERNAL",
      "supportedMissingness": [
        "NOT_COLLECTED",
        "UNAVAILABLE",
        "REDACTED",
        "COLLECTION_ERROR"
      ],
      "purpose": "practice-detection",
      "retentionPolicy": "AGENT_EVIDENCE_RETENTION",
      "erasurePolicy": "WORKSPACE_AND_PERSON_ERASURE",
      "useDecisionId": "use-scm-pull-request-diff"
    },
    {
      "kind": "scm.pull-request.comments",
      "description": "Inline pull-request review comments mirrored by the application.",
      "selectionScope": "The 500 most recent inline comments for one pull request; older comments are omitted and the source is PARTIAL when more exist.",
      "artifactTypes": [
        "PULL_REQUEST"
      ],
      "authority": "SYNCHRONIZED_MIRROR",
      "captureTime": "COLLECTION_TIME_SNAPSHOT",
