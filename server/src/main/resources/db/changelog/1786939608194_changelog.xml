<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="practice-feedback-helpfulness" id="1786939608194-1">
        <preConditions onFail="MARK_RAN" onFailMessage="feedback_helpfulness_vote already exists">
            <not><tableExists tableName="feedback_helpfulness_vote"/></not>
        </preConditions>
        <comment>Store a learner's usefulness rating for delivered practice feedback.</comment>
        <createTable tableName="feedback_helpfulness_vote">
            <column name="feedback_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="feedback_helpfulness_votePK"/>
            </column>
            <column name="helpful" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseColumnNames="feedback_id"
                baseTableName="feedback_helpfulness_vote"
                constraintName="fk_feedback_helpfulness_vote_feedback"
                referencedColumnNames="id"
                referencedTableName="feedback"/>
        <rollback>
            <dropTable tableName="feedback_helpfulness_vote"/>
        </rollback>
    </changeSet>

    <changeSet author="practice-feedback-helpfulness" id="1786939608194-2">
        <preConditions onFail="MARK_RAN" onFailMessage="feedback helpfulness foreign key is unavailable">
            <foreignKeyConstraintExists foreignKeyName="fk_feedback_helpfulness_vote_feedback"/>
        </preConditions>
        <comment>Delete usefulness ratings with their parent feedback unit.</comment>
        <dropForeignKeyConstraint
                baseTableName="feedback_helpfulness_vote"
                constraintName="fk_feedback_helpfulness_vote_feedback"/>
        <addForeignKeyConstraint
                baseColumnNames="feedback_id"
                baseTableName="feedback_helpfulness_vote"
                constraintName="fk_feedback_helpfulness_vote_feedback"
                referencedColumnNames="id"
                referencedTableName="feedback"
                onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="feedback_helpfulness_vote"
                    constraintName="fk_feedback_helpfulness_vote_feedback"/>
            <addForeignKeyConstraint
                    baseColumnNames="feedback_id"
                    baseTableName="feedback_helpfulness_vote"
                    constraintName="fk_feedback_helpfulness_vote_feedback"
                    referencedColumnNames="id"
                    referencedTableName="feedback"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
