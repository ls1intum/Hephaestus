<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="practice-feedback-rating" id="1786939608194-1">
        <preConditions onFail="MARK_RAN" onFailMessage="feedback_rating already exists">
            <not><tableExists tableName="feedback_rating"/></not>
        </preConditions>
        <comment>Store a recipient's current assessment of delivered practice feedback.</comment>
        <createTable tableName="feedback_rating">
            <column name="feedback_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="feedback_ratingPK"/>
            </column>
            <column name="state" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseColumnNames="feedback_id"
                baseTableName="feedback_rating"
                constraintName="fk_feedback_rating_feedback"
                referencedColumnNames="id"
                referencedTableName="feedback"
                onDelete="CASCADE"/>
        <sql>
            ALTER TABLE feedback_rating
            ADD CONSTRAINT chk_feedback_rating_state CHECK (state IN ('HELPFUL', 'UNHELPFUL', 'INCORRECT'));
        </sql>
        <rollback>
            <dropTable tableName="feedback_rating"/>
        </rollback>
    </changeSet>
    <changeSet author="practice-area-weight" id="1786939608194-2">
        <preConditions onFail="MARK_RAN" onFailMessage="practice.area_weight already exists">
            <not><columnExists tableName="practice" columnName="area_weight"/></not>
        </preConditions>
        <comment>How much a practice counts when its area is summarised; 1.0 keeps a plain average.</comment>
        <addColumn tableName="practice">
            <column name="area_weight" type="DOUBLE PRECISION" defaultValueNumeric="1.0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE practice
            ADD CONSTRAINT chk_practice_area_weight CHECK (area_weight &gt;= 0);
        </sql>
        <rollback>
            <dropColumn tableName="practice" columnName="area_weight"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
