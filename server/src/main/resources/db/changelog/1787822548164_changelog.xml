<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="practice-feedback-response" id="1787822548164-1">
        <preConditions onFail="MARK_RAN" onFailMessage="reaction.usefulness already exists">
            <not><columnExists tableName="reaction" columnName="usefulness"/></not>
        </preConditions>
        <comment>Add perceived usefulness to the append-only feedback response timeline.</comment>
        <addColumn tableName="reaction">
            <column name="usefulness" type="VARCHAR(16)"/>
        </addColumn>
        <dropNotNullConstraint tableName="reaction" columnName="action" columnDataType="VARCHAR(16)"/>
        <dropIndex tableName="reaction" indexName="idx_reaction_correlation"/>
        <sql>
            ALTER TABLE reaction
            ADD CONSTRAINT chk_reaction_usefulness CHECK (usefulness IN ('HELPFUL', 'UNHELPFUL'));
            ALTER TABLE reaction
            ADD CONSTRAINT chk_reaction_response_shape CHECK (
                usefulness IS NOT NULL OR action IS NOT NULL OR explanation IS NULL
            );
        </sql>
        <rollback>
            <sql>
                DELETE FROM reaction WHERE action IS NULL;
            </sql>
            <sql>ALTER TABLE reaction DROP CONSTRAINT chk_reaction_usefulness;</sql>
            <sql>ALTER TABLE reaction DROP CONSTRAINT chk_reaction_response_shape;</sql>
            <createIndex tableName="reaction" indexName="idx_reaction_correlation">
                <column name="recurrence_key"/>
            </createIndex>
            <addNotNullConstraint tableName="reaction" columnName="action" columnDataType="VARCHAR(16)"/>
            <dropColumn tableName="reaction" columnName="usefulness"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
