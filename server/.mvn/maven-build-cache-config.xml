<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0 https://maven.apache.org/xsd/build-cache-config-1.4.0.xsd">
    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <validateXml>true</validateXml>
        <local>
            <maxBuildsCached>3</maxBuildsCached>
        </local>
        <projectVersioning adjustMetaInf="true" calculateProjectVersionChecksum="true"/>
    </configuration>
    <input>
        <global>
            <includes>
                <include recursive="true">src/main</include>
            </includes>
        </global>
    </input>
    <executionControl>
        <runAlways>
            <plugins>
                <plugin groupId="org.apache.maven.plugins" artifactId="maven-install-plugin"/>
            </plugins>
        </runAlways>
    </executionControl>
</cache>
