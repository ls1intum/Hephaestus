<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1791714969989-1" author="hephaestus">
        <createTable tableName="review_composition_basis">
            <column name="job_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="review_composition_basisPK"/>
            </column>
            <column name="admission_attempt" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="admission_digest" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="basis_digest" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="basis_version" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="byte_size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="copy_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1791714969989-2" author="hephaestus">
        <addForeignKeyConstraint baseTableName="review_composition_basis" baseColumnNames="workspace_id,job_id" referencedTableName="agent_job" referencedColumnNames="workspace_id,id" constraintName="sfk_review_composition_basis_job" onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
