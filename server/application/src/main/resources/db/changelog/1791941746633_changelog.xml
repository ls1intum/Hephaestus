<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1791941746633-1" author="hephaestus">
        <addColumn tableName="llm_usage_event">
            <column defaultValue="UNKNOWN" name="measurement_verification" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <stop>Restore the verified database backup taken before the usage verification upgrade; dropping measurement decisions is not a safe rollback.</stop>
        </rollback>
    </changeSet>
    <changeSet id="1791941746633-2" author="hephaestus">
        <preConditions onFail="HALT" onError="HALT">
            <columnExists schemaName="public" tableName="llm_usage_event" columnName="measurement_verification"/>
        </preConditions>
        <sql><![CDATA[
ALTER TABLE public.llm_usage_event
    ADD CONSTRAINT ck_llm_usage_event_measurement_verification
    CHECK (measurement_verification IN ('UNKNOWN', 'VERIFIED', 'UNVERIFIABLE'));
        ]]></sql>
        <rollback>
            <sql>ALTER TABLE public.llm_usage_event DROP CONSTRAINT ck_llm_usage_event_measurement_verification;</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
