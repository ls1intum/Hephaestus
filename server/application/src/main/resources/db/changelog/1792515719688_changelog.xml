<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1792515719688-1" author="hephaestus">
        <createTable tableName="review_job_attempt_charge">
            <column name="attempt" type="INTEGER">
                <constraints nullable="false" primaryKey="true" primaryKeyName="review_job_attempt_chargePK"/>
            </column>
            <column name="job_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="review_job_attempt_chargePK"/>
            </column>
            <column name="model_kind" type="VARCHAR(16)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="review_job_attempt_chargePK"/>
            </column>
            <column name="applied_per_1m_cache_read_usd" type="numeric(18, 8)"/>
            <column name="applied_per_1m_cache_write_usd" type="numeric(18, 8)"/>
            <column name="applied_per_1m_input_usd" type="numeric(18, 8)"/>
            <column name="applied_per_1m_output_usd" type="numeric(18, 8)"/>
            <column name="applied_price_id" type="BIGINT"/>
            <column name="applied_workspace_model_id" type="BIGINT"/>
            <column name="funding_source" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="VARCHAR(128)"/>
            <column name="pricing_state" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1792515719688-2" author="hephaestus">
        <createTable tableName="review_job_attempt_usage">
            <column name="attempt" type="INTEGER">
                <constraints nullable="false" primaryKey="true" primaryKeyName="review_job_attempt_usagePK"/>
            </column>
            <column name="job_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="review_job_attempt_usagePK"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP(6) WITH TIME ZONE"/>
            <column defaultValueNumeric="0" name="proxy_cache_read_tokens" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="proxy_cache_write_tokens" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="proxy_calls" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="proxy_input_tokens" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="proxy_output_tokens" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="proxy_reasoning_tokens" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="runner_cache_read_tokens" type="INTEGER"/>
            <column name="runner_cache_write_tokens" type="INTEGER"/>
            <column name="runner_calls" type="INTEGER"/>
            <column name="runner_input_tokens" type="INTEGER"/>
            <column name="runner_output_tokens" type="INTEGER"/>
            <column name="runner_reasoning_tokens" type="INTEGER"/>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1792515719688-3" author="hephaestus">
        <addUniqueConstraint columnNames="job_id, attempt, workspace_id" constraintName="uk_review_job_attempt_usage_workspace" tableName="review_job_attempt_usage"/>
    </changeSet>
    <changeSet id="1792515719688-4" author="hephaestus">
        <createIndex indexName="idx_review_job_attempt_charge_workspace" tableName="review_job_attempt_charge">
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="1792515719688-5" author="hephaestus">
        <createIndex indexName="idx_review_job_attempt_usage_workspace" tableName="review_job_attempt_usage">
            <column name="workspace_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="1792515719688-6" author="hephaestus">
        <addForeignKeyConstraint baseTableName="review_job_attempt_usage" baseColumnNames="job_id,workspace_id" referencedTableName="review_job" referencedColumnNames="id,workspace_id" constraintName="sfk_review_job_attempt_usage_job" onDelete="CASCADE" validate="true"/>
        <addForeignKeyConstraint baseTableName="review_job_attempt_usage" baseColumnNames="workspace_id" referencedTableName="workspace" referencedColumnNames="id" constraintName="sfk_review_job_attempt_usage_workspace" onDelete="RESTRICT" validate="true"/>
        <addForeignKeyConstraint baseTableName="review_job_attempt_charge" baseColumnNames="job_id,attempt,workspace_id" referencedTableName="review_job_attempt_usage" referencedColumnNames="job_id,attempt,workspace_id" constraintName="sfk_review_job_attempt_charge_usage" onDelete="CASCADE" validate="true"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="review_job_attempt_charge" constraintName="sfk_review_job_attempt_charge_usage"/>
            <dropForeignKeyConstraint baseTableName="review_job_attempt_usage" constraintName="sfk_review_job_attempt_usage_workspace"/>
            <dropForeignKeyConstraint baseTableName="review_job_attempt_usage" constraintName="sfk_review_job_attempt_usage_job"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
