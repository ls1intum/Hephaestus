{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hephaestus.aet.cit.tum.de/contracts/items/scm/repository.schema.json",
  "type": "object",
  "properties": {
    "repositoryId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "commitId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "required": [
    "repositoryId",
    "providerId",
    "commitId"
  ],
  "additionalProperties": false
}
