language js(typescript)

// A play function already receives `canvas` — a Testing Library instance bound to the story's own
// canvas — so `within(canvasElement)` rebuilds by hand the argument that was handed in. Two spellings
// of one thing is the whole cost: a reader has to check which one a file uses before copying a line
// out of it, and half the repo's play functions open with a binding that carries no information.
//
// Deliberately narrow, so the neighbouring shapes that do real work keep working:
//   within(canvas.getByRole("group", …))  — scoping into a subtree, which `canvas` cannot do for you
//   within(await screen.findByRole(…))    — scoping into a portal, which is outside the canvas
//   canvasElement.querySelector(…)        — reaching for an element by something other than a role,
//                                           and `canvasElement.clientWidth` for reflow assertions:
//                                           the argument itself is fine, only re-deriving `canvas`
//                                           from it is not.
// Keyed on the argument being the identifier `canvasElement` exactly, so `within(someOtherRoot)`
// never matches. The argument is bound to `$root` only because `register_diagnostic` needs a real
// metavariable to point at: `span = $_` makes the plugin report itself as "errored: cannot make
// resolved pattern from arbitrary pattern UNDERSCORE" — an `info` that fails nothing while looking
// wired up.
`within($root)` where {
  $root <: `canvasElement`,
  register_diagnostic(
    span = $root,
    message = "The play function already gets `canvas` bound to this element, so `within(canvasElement)` re-derives an argument it was handed. Destructure `canvas` in the play signature and use it directly. `within(...)` stays right for scoping into a subtree — `within(canvas.getByRole('group', …))` — or into a portal off the canvas.",
    severity = "error"
  )
}
