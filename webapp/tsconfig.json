{
	"include": ["**/*.ts", "**/*.tsx", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
	// The Playwright tree and the Node modules of `tools/` carry their own `tsconfig.json`; the
	// browser page of the code editor check in `tools/` is the SPA's.
	"exclude": ["e2e", "tools/**/*.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		// Vite's default browser target decides the lib, and `toSorted` and `Promise.withResolvers`
		// are past it. Only `e2e/` and the `tools/` modules, which run on Node, widen it (their own `tsconfig.json`).
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"paths": {
			"@/brand/*": ["./brand/*"],
			"@/*": ["./src/*"],
			"@bundled-practices": [
				"../server/application/src/main/resources/practices/default-catalog.json"
			],
			"@bundled-practice-guidance/*": [
				"../server/application/src/main/resources/practices/guidance/*"
			]
		}
	}
}
