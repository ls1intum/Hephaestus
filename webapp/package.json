{
	"name": "webapp",
	"version": "0.0.0-development",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "vite build && tsc",
		"serve": "vite preview",
		"test": "vitest run --exclude 'tools/oxlint/rules/**' --maxWorkers=4 && pnpm run test:lint-rules",
		"test:watch": "vitest --exclude 'tools/oxlint/rules/**' --maxWorkers=4",
		"test:coverage": "vitest run --coverage --exclude 'tools/oxlint/rules/**' --maxWorkers=4",
		"test:lint-rules": "vitest run tools/oxlint/rules --maxWorkers=1 --outputFile.junit=./test-results/junit-webapp-lint-rules.xml",
		"test:storybook": "vitest run --config vitest.config.storybook.ts",
		"typecheck": "tsc --noEmit",
		"format": "cd .. && oxfmt --write 'webapp/**/*.{js,jsx,ts,tsx,json,jsonc,css}'",
		"format:check": "cd .. && oxfmt --check 'webapp/**/*.{js,jsx,ts,tsx,json,jsonc,css}'",
		"lint": "cd .. && oxlint webapp",
		"lint:fix": "cd .. && oxlint --fix webapp",
		"check": "run-s -c format:check lint",
		"check:fix": "run-s -c lint:fix format",
		"build-storybook": "storybook build --stats-json",
		"chromatic": "chromatic --exit-zero-on-changes",
		"chromatic:ci": "chromatic --only-changed",
		"chromatic:dry-run": "chromatic --dry-run",
		"test:e2e": "playwright test",
		"export:readme-assets": "node scripts/export-readme-assets.ts",
		"storybook:dev": "storybook dev -p 6006",
		"generate:api": "openapi-ts"
	},
	"dependencies": {
		"@ai-sdk/react": "4.0.82",
		"@base-ui/react": "1.7.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@monaco-editor/react": "^4.7.0",
		"@primer/octicons-react": "19.33.0",
		"@sentry/react": "10.71.0",
		"@tanstack/react-query": "5.102.5",
		"@tanstack/react-query-devtools": "5.102.5",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-table": "9.1.2",
		"@xyflow/react": "^12.11.5",
		"ai": "7.0.79",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"fast-deep-equal": "3.1.3",
		"lucide-react": "1.34.0",
		"motion": "13.1.1",
		"posthog-js": "1.419.4",
		"react": "19.2.8",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.8",
		"sonner": "2.0.8",
		"streamdown": "2.6.0",
		"tailwind-merge": "3.6.0",
		"use-sync-external-store": "1.6.0",
		"usehooks-ts": "3.1.1",
		"uuid": "14.0.2",
		"zod": "4.4.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.2.1",
		"@gitlab/svgs": "3.163.0",
		"@hey-api/openapi-ts": "0.0.0-next-20260824173136",
		"@oxlint/plugins": "1.79.0",
		"@playwright/test": "1.60.0",
		"@primer/primitives": "11.9.0",
		"@storybook/addon-a11y": "10.4.0",
		"@storybook/addon-docs": "10.4.0",
		"@storybook/addon-onboarding": "10.4.0",
		"@storybook/addon-themes": "10.4.0",
		"@storybook/addon-vitest": "10.4.0",
		"@storybook/react": "10.4.0",
		"@storybook/react-vite": "10.4.0",
		"@tailwindcss/typography": "0.5.19",
		"@tailwindcss/vite": "4.3.0",
		"@tanstack/router-plugin": "1.168.35",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/hast": "3.0.5",
		"@types/node": "24.12.4",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.0",
		"@vitest/browser": "4.1.11",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"chromatic": "16.10.1",
		"jsdom": "29.1.1",
		"msw": "2.14.6",
		"msw-storybook-addon": "2.0.7",
		"npm-run-all2": "8.0.4",
		"oxc-transform-react": "0.145.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "7.0.2001",
		"playwright": "1.60.0",
		"storybook": "10.4.0",
		"tailwindcss": "4.3.0",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-terminal": "1.4.0",
		"vitest": "4.1.11"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
