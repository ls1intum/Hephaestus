{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"root": false,
	"plugins": [
		"./.biome/no-redundant-in-the-document.grit",
		"./.biome/no-within-canvas-element.grit",
		"./.biome/typed-story-meta.grit"
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/*.config.ts",
			"**/vite.shared.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/api/**/*.ts",
			"!**/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"noUselessElse": "error",
				"useCollapsedElseIf": "off",
				"useConst": "error",
				"useExplicitLengthCheck": "off",
				"useForOf": "error",
				"useShorthandAssign": "error",
				"useTemplate": "error"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noDocumentCookie": "off",
				"noDoubleEquals": "error",
				"useIterableCallbackReturn": "off"
			},
			"a11y": {
				"useSemanticElements": "off",
				"useAriaPropsForRole": "off",
				"useFocusableInteractive": "off",
				"useKeyWithClickEvents": "off",
				"useAnchorContent": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["src/components/**", "src/lib/**", "src/hooks/**", "src/integrations/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"filenameCases": ["kebab-case", "PascalCase"],
								"strictCase": false,
								"requireAscii": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noUselessElse": "off",
						"useForOf": "off",
						"useShorthandAssign": "off",
						"useTemplate": "off"
					},
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"a11y": {
						"noLabelWithoutControl": "off",
						"noRedundantRoles": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		},
		"linter": {
			"enabled": false
		},
		"formatter": {
			"enabled": false
		}
	}
}
